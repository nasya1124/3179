{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hexagonal bin map of NASA FIRMS MODIS (Collection 6.1) fire detections, 1 September 2019 to 29 February 2020: vegetation fires with confidence of 30 or more, counted into equal-area hexagons (pre-projected, conic equal-area; drawn with an identity projection). The month is set by the controls under the chart (script.js).",
  "title": {
    "text": "Where fires burned in the Black Summer",
    "subtitle": "Satellite fire detections per hexagon · September 2019 to February 2020",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 19.2,
    "fontWeight": 700,
    "color": "#1f3326",
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 14,
    "subtitleColor": "#44524a",
    "offset": 10
  },
  "width": 600,
  "height": 470,
  "background": null,
  "projection": {
    "type": "identity"
  },
  "params": [
    {
      "name": "month",
      "value": "All"
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/fire_detections_hexbin.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "!datum.properties.outline"
        },
        {
          "calculate": "datum.properties[month]",
          "as": "n"
        },
        {
          "calculate": "datum.n >= 1000 ? '1,000 or more' : datum.n >= 200 ? '200–999' : datum.n >= 50 ? '50–199' : datum.n >= 10 ? '10–49' : datum.n >= 1 ? '1–9' : 'None'",
          "as": "Class"
        },
        {
          "calculate": "datum.properties['2019-09']",
          "as": "Sep"
        },
        {
          "calculate": "datum.properties['2019-10']",
          "as": "Oct"
        },
        {
          "calculate": "datum.properties['2019-11']",
          "as": "Nov"
        },
        {
          "calculate": "datum.properties['2019-12']",
          "as": "Dec"
        },
        {
          "calculate": "datum.properties['2020-01']",
          "as": "Jan"
        },
        {
          "calculate": "datum.properties['2020-02']",
          "as": "Feb"
        },
        {
          "calculate": "month == 'All' ? 'Whole season' : month",
          "as": "Shown"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f6f3ec",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "Class",
          "type": "ordinal",
          "title": "Fire detections per hexagon (each about 6,300 km²)",
          "scale": {
            "domain": [
              "None",
              "1–9",
              "10–49",
              "50–199",
              "200–999",
              "1,000 or more"
            ],
            "range": [
              "#e6e2d6",
              "#f1dcb4",
              "#e8b878",
              "#d9855a",
              "#b5523b",
              "#7a2e22"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 6,
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeColor": "#c9c2b4",
            "symbolStrokeWidth": 0.5,
            "labelFontSize": 14,
            "titleFontSize": 14,
            "titleLimit": 420,
            "columnPadding": 12
          }
        },
        "tooltip": [
          {
            "field": "properties.State",
            "title": "State or territory"
          },
          {
            "field": "n",
            "type": "quantitative",
            "title": "Fire detections shown",
            "format": ","
          },
          {
            "field": "properties.All",
            "type": "quantitative",
            "title": "Whole season",
            "format": ","
          },
          {
            "field": "Shown",
            "title": "Showing"
          },
          {
            "field": "Sep",
            "type": "quantitative",
            "title": "Sep"
          },
          {
            "field": "Oct",
            "type": "quantitative",
            "title": "Oct"
          },
          {
            "field": "Nov",
            "type": "quantitative",
            "title": "Nov"
          },
          {
            "field": "Dec",
            "type": "quantitative",
            "title": "Dec"
          },
          {
            "field": "Jan",
            "type": "quantitative",
            "title": "Jan"
          },
          {
            "field": "Feb",
            "type": "quantitative",
            "title": "Feb"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/fire_detections_hexbin.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.outline"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#8f8a7a",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "x": 8,
        "y": 6,
        "fontSize": 19.2,
        "fontWeight": 700,
        "color": "#1f3326",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif"
      },
      "encoding": {
        "text": {
          "value": {
            "expr": "{'All': 'Whole season', '2019-09': 'September 2019', '2019-10': 'October 2019', '2019-11': 'November 2019', '2019-12': 'December 2019', '2020-01': 'January 2020', '2020-02': 'February 2020'}[month]"
          }
        }
      }
    },
