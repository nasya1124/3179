{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Forest area by state (2023)",
    "anchor": "start"
  },
  "width": 250,
  "height": 350,
  "data": {
    "url": "data/forest_area_by_state.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.State === 'Australian Capital Territory' ? format(datum.Forest_area_kha, ',') + ' (too small to see at this scale)' : ''",
      "as": "Label"
    }
  ],
  "encoding": {
    "x": {
      "field": "Forest_area_kha",
      "type": "quantitative",
      "title": "Forest area (thousand hectares)",
      "axis": {
        "format": ",.0f",
        "grid": true,
        "labelFontSize": 13,
        "titleFontSize": 14,
        "tickCount": 3
      }
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 13,
        "labelLimit": 220
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#4f7a62",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "Forest_area_kha",
            "type": "quantitative",
            "title": "Forest area (thousand hectares)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "font": "Arial",
        "fontSize": 12,
        "color": "#56655a"
      },
      "encoding": {
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#24392d",
      "titleColor": "#24392d",
      "labelFontSize": 13,
      "titleFontSize": 14,
      "gridColor": "#e8e1d4"
    },
    "title": {
      "font": "Arial",
      "fontSize": 20,
      "fontWeight": "bold",
      "color": "#24392d"
    }
  }
}