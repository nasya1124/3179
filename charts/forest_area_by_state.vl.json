{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Native forest area by state, 2023",
    "subtitle": "Thousand hectares",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 19,
    "fontWeight": 700,
    "color": "#1f3326",
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 14,
    "subtitleColor": "#5b6a5f",
    "offset": 10
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/forest_area_by_state.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.State === 'Australian Capital Territory' ? '130 thousand hectares (too small to show)' : ''",
      "as": "Label"
    }
  ],
  "encoding": {
    "x": {
      "field": "Forest_area_kha",
      "type": "quantitative",
      "title": "Forest area (thousand hectares)",
      "axis": {
        "format": ",.0f",
        "grid": true,
        "labelFontSize": 14,
        "titleFontSize": 13,
        "tickCount": 3,
        "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "titleFontWeight": 600,
        "titleColor": "#3d4d42",
        "titlePadding": 10
      }
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "title": "State or territory",
      "sort": [
        "Queensland",
        "Northern Territory",
        "Western Australia",
        "New South Wales",
        "Victoria",
        "South Australia",
        "Tasmania",
        "Australian Capital Territory"
      ],
      "axis": {
        "labelFontSize": 14,
        "labelLimit": 220,
        "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#3d4d42",
        "titlePadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#3f6f55",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "Forest_area_kha",
            "type": "quantitative",
            "title": "Forest area (thousand hectares)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 13,
        "color": "#56655a"
      },
      "encoding": {
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.State === 'Queensland'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 14,
        "color": "#ffffff",
        "align": "right",
        "baseline": "middle",
        "dx": -8,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "value": "39% of all native forest"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "labelColor": "#3d4d42",
      "titleColor": "#24392d",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "gridColor": "#e8e1d4"
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "fontSize": 20,
      "fontWeight": "bold",
      "color": "#24392d"
    },
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#3d4d42",
      "titleColor": "#1f3326"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": null
}