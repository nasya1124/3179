{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Mix of plantation planted each year, by state",
    "subtitle": "Share of area planted or replanted · annual average 2016–17 to 2020–21",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 19,
    "fontWeight": 700,
    "color": "#1f3326",
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 14,
    "subtitleColor": "#5b6a5f",
    "offset": 10
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/plantation_establishment_by_jurisdiction.csv",
    "format": {
      "type": "csv"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "bar": {
      "binSpacing": 3
    },
    "axis": {
      "labelLimit": 220,
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#3d4d42"
    },
    "legend": {
      "padding": 8,
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#3d4d42",
      "titleColor": "#1f3326"
    },
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": null,
  "transform": [
    {
      "filter": "datum.Jurisdiction != 'Australia'"
    }
  ],
  "encoding": {
    "y": {
      "field": "Jurisdiction",
      "type": "nominal",
      "sort": [
        "Queensland",
        "New South Wales and Australian Capital Territory",
        "South Australia",
        "Victoria",
        "Western Australia and Northern Territory",
        "Tasmania"
      ],
      "axis": {
        "title": null,
        "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "labelFontSize": 14,
        "labelColor": "#56655a",
        "domain": false,
        "ticks": false,
        "labelLimit": 260,
        "labelExpr": "indexof(datum.label, ' and ') > 0 ? [slice(datum.label, 0, indexof(datum.label, ' and ')), slice(datum.label, indexof(datum.label, ' and ') + 1)] : datum.label",
        "labelLineHeight": 15
      },
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "Annual_average_kha",
          "type": "quantitative",
          "stack": "normalize",
          "title": null,
          "axis": {
            "format": ".0%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "grid": true,
            "gridColor": "#e6e1d5",
            "labelFontSize": 14,
            "labelColor": "#3d4d42",
            "domainColor": "#c8c2b6",
            "tickColor": "#c8c2b6",
            "domain": false
          },
          "scale": {
            "domain": [
              0,
              1.5
            ],
            "nice": false
          }
        },
        "color": {
          "field": "Plantation_type",
          "type": "nominal",
          "title": "Plantation type",
          "sort": [
            "Softwood",
            "Hardwood"
          ],
          "scale": {
            "domain": [
              "Hardwood",
              "Softwood"
            ],
            "range": [
              "#8a6a4f",
              "#6b7f95"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleColor": "#263d2e",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 14,
            "labelColor": "#56655a",
            "symbolType": "square",
            "title": null
          }
        },
        "opacity": {
          "condition": {
            "test": "hl == null || datum.Plantation_type == hl",
            "value": 1
          },
          "value": 0.25
        },
        "tooltip": [
          {
            "field": "Jurisdiction",
            "title": "State or territory"
          },
          {
            "field": "Plantation_type",
            "title": "Plantation type"
          },
          {
            "field": "Share",
            "type": "quantitative",
            "title": "Share of area planted",
            "format": ".0%"
          },
          {
            "field": "Annual_average_kha",
            "type": "quantitative",
            "title": "Area per year (thousand hectares)",
            "format": ",.1f"
          }
        ],
        "order": {
          "field": "ord",
          "type": "quantitative"
        }
      },
      "transform": [
        {
          "calculate": "datum.Plantation_type == 'Softwood' ? 0 : 1",
          "as": "ord"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "Annual_average_kha",
              "as": "Total"
            }
          ],
          "groupby": [
            "Jurisdiction"
          ]
        },
        {
          "calculate": "datum.Annual_average_kha / datum.Total",
          "as": "Share"
        }
      ],
      "params": [
        {
          "name": "legend_pick",
          "select": {
            "type": "point",
            "fields": [
              "Plantation_type"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Annual_average_kha",
              "as": "Total"
            }
          ],
          "groupby": [
            "Jurisdiction"
          ]
        },
        {
          "calculate": "format(datum.Total*1000, ',.0f') + ' hectares a year'",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 13,
        "color": "#5b6a5f",
        "align": "left",
        "dx": 8,
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "text": {
          "field": "lbl"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.Plantation_type == 'Softwood' ? 0 : 1",
          "as": "ord"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "Annual_average_kha",
              "as": "Total"
            }
          ],
          "groupby": [
            "Jurisdiction"
          ]
        },
        {
          "calculate": "datum.Annual_average_kha / datum.Total",
          "as": "Share"
        },
        {
          "stack": "Annual_average_kha",
          "groupby": [
            "Jurisdiction"
          ],
          "sort": [
            {
              "field": "ord"
            }
          ],
          "as": [
            "s0",
            "s1"
          ],
          "offset": "normalize"
        },
        {
          "calculate": "(datum.s0 + datum.s1) / 2",
          "as": "mid"
        },
        {
          "filter": "(datum.Jurisdiction == 'Queensland' && datum.Plantation_type == 'Softwood') || (datum.Jurisdiction == 'Tasmania' && datum.Plantation_type == 'Hardwood')"
        },
        {
          "calculate": "datum.Plantation_type + ' ' + format(datum.Share, '.0%')",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#ffffff",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "lbl"
        },
        "opacity": {
          "condition": {
            "test": "hl == null || datum.Plantation_type == hl",
            "value": 1
          },
          "value": 0.35
        }
      }
    }
  ],
  "params": [
    {
      "name": "hl",
      "value": null
    }
  ]
}
