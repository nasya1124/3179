{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Plantation planted or replanted each year",
    "subtitle": "Annual average, thousand hectares · 2016–17 to 2020–21",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 17,
    "fontWeight": 700,
    "color": "#1f3326",
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5b6a5f",
    "offset": 10
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/plantation_establishment_by_jurisdiction.csv",
    "format": {
      "type": "csv"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "bar": {
      "binSpacing": 3
    },
    "axis": {
      "labelLimit": 220,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#3d4d42"
    },
    "legend": {
      "padding": 8,
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#3d4d42",
      "titleColor": "#1f3326"
    },
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": null,
  "transform": [
    {
      "filter": "datum.Jurisdiction != 'Australia'"
    }
  ],
  "encoding": {
    "y": {
      "field": "Jurisdiction",
      "type": "nominal",
      "sort": [
        "Victoria",
        "Western Australia and Northern Territory",
        "New South Wales and Australian Capital Territory",
        "Tasmania",
        "Queensland",
        "South Australia"
      ],
      "axis": {
        "title": null,
        "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "labelFontSize": 13,
        "labelColor": "#56655a",
        "domain": false,
        "ticks": false,
        "labelLimit": 260,
        "labelExpr": "indexof(datum.label, ' and ') > 0 ? [slice(datum.label, 0, indexof(datum.label, ' and ')), slice(datum.label, indexof(datum.label, ' and ') + 1)] : datum.label",
        "labelLineHeight": 15
      },
      "title": null
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "plantation_type_highlight",
          "select": {
            "type": "point",
            "fields": [
              "Plantation_type"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "bar",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "Annual_average_kha",
          "type": "quantitative",
          "stack": "zero",
          "title": null,
          "axis": {
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleFontSize": 13,
            "titleColor": "#263d2e",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 12,
            "labelColor": "#56655a",
            "grid": true,
            "gridColor": "#e6e1d5",
            "gridOpacity": 1,
            "tickColor": "#c8c2b6",
            "domainColor": "#c8c2b6",
            "tickCount": 6
          },
          "scale": {
            "domain": [
              0,
              16
            ]
          }
        },
        "color": {
          "field": "Plantation_type",
          "type": "nominal",
          "title": "Plantation type",
          "sort": [
            "Hardwood",
            "Softwood"
          ],
          "scale": {
            "domain": [
              "Hardwood",
              "Softwood"
            ],
            "range": [
              "#8a6a4f",
              "#6b7f95"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleColor": "#263d2e",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 12,
            "labelColor": "#56655a",
            "symbolType": "square",
            "title": null
          }
        },
        "opacity": {
          "condition": {
            "param": "plantation_type_highlight",
            "value": 1
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "Jurisdiction",
            "type": "nominal",
            "title": "Jurisdiction"
          },
          {
            "field": "Plantation_type",
            "type": "nominal",
            "title": "Plantation type"
          },
          {
            "field": "Annual_average_kha",
            "type": "quantitative",
            "title": "Annual average (thousand hectares)",
            "format": ",.3f"
          },
          {
            "field": "Period",
            "type": "nominal",
            "title": "Period"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Annual_average_kha",
              "as": "Total"
            }
          ],
          "groupby": [
            "Jurisdiction"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 13,
        "color": "#5b6a5f",
        "align": "left",
        "baseline": "middle",
        "dx": 6
      },
      "encoding": {
        "x": {
          "field": "Total",
          "type": "quantitative"
        },
        "text": {
          "field": "Total",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}
