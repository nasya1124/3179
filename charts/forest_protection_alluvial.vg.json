{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Native forest area by tenure and inclusion in the National Reserve System, based on ABARES Indicator 1.1c-2 (2020-21).",
  "height": 420,
  "padding": {
    "left": 0,
    "right": 0,
    "top": 6,
    "bottom": 6
  },
  "title": {
    "text": "Native forest by land tenure and reserve status",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 17,
    "fontWeight": 700,
    "color": "#1f3326",
    "offset": 10,
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5b6a5f",
    "subtitle": "Band width shows forest area · 2020–21"
  },
  "data": [
    {
      "name": "forest",
      "url": "data/forest_protection_alluvial.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Forest_area_kha": "number"
        }
      }
    },
    {
      "name": "leftNodes",
      "source": "forest",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Tenure"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "Forest_area_kha"
          ],
          "as": [
            "area"
          ]
        },
        {
          "type": "stack",
          "field": "area",
          "sort": {
            "field": "Tenure",
            "order": "ascending"
          },
          "as": [
            "y0",
            "y1"
          ]
        }
      ]
    },
    {
      "name": "rightNodes",
      "source": "forest",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Status"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "Forest_area_kha"
          ],
          "as": [
            "area"
          ]
        },
        {
          "type": "stack",
          "field": "area",
          "sort": {
            "field": "Status",
            "order": "ascending"
          },
          "as": [
            "y0",
            "y1"
          ]
        }
      ]
    },
    {
      "name": "targetFlowPositions",
      "source": "forest",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.Tenure + '|' + datum.Status",
          "as": "flowKey"
        },
        {
          "type": "stack",
          "groupby": [
            "Status"
          ],
          "field": "Forest_area_kha",
          "sort": {
            "field": "Tenure",
            "order": "ascending"
          },
          "as": [
            "target0",
            "target1"
          ]
        }
      ]
    },
    {
      "name": "flowPaths",
      "source": "forest",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.Tenure + '|' + datum.Status",
          "as": "flowKey"
        },
        {
          "type": "stack",
          "groupby": [
            "Tenure"
          ],
          "field": "Forest_area_kha",
          "sort": {
            "field": "Status",
            "order": "ascending"
          },
          "as": [
            "source0",
            "source1"
          ]
        },
        {
          "type": "lookup",
          "from": "leftNodes",
          "key": "Tenure",
          "fields": [
            "Tenure"
          ],
          "values": [
            "y0"
          ],
          "as": [
            "sourceNode0"
          ]
        },
        {
          "type": "lookup",
          "from": "targetFlowPositions",
          "key": "flowKey",
          "fields": [
            "flowKey"
          ],
          "values": [
            "target0",
            "target1"
          ],
          "as": [
            "target0",
            "target1"
          ]
        },
        {
          "type": "lookup",
          "from": "rightNodes",
          "key": "Status",
          "fields": [
            "Status"
          ],
          "values": [
            "y0"
          ],
          "as": [
            "targetNode0"
          ]
        },
        {
          "type": "formula",
          "expr": "'M ' + (lx+nw) + ',' + scale('yscale', datum.sourceNode0 + datum.source0) + ' C ' + ((lx+nw+rx)/2) + ',' + scale('yscale', datum.sourceNode0 + datum.source0) + ' ' + ((lx+nw+rx)/2) + ',' + scale('yscale', datum.targetNode0 + datum.target0) + ' ' + rx + ',' + scale('yscale', datum.targetNode0 + datum.target0) + ' L ' + rx + ',' + scale('yscale', datum.targetNode0 + datum.target1) + ' C ' + ((lx+nw+rx)/2) + ',' + scale('yscale', datum.targetNode0 + datum.target1) + ' ' + ((lx+nw+rx)/2) + ',' + scale('yscale', datum.sourceNode0 + datum.source1) + ' ' + (lx+nw) + ',' + scale('yscale', datum.sourceNode0 + datum.source1) + ' Z'",
          "as": "path"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "yscale",
      "type": "linear",
      "domain": [
        0,
        131502
      ],
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": false,
      "zero": true
    },
    {
      "name": "statusColor",
      "type": "ordinal",
      "domain": [
        "Within the National Reserve System",
        "Outside the National Reserve System"
      ],
      "range": [
        "#1f6f78",
        "#dcd6c7"
      ]
    },
    {
      "name": "tenureColor",
      "type": "ordinal",
      "domain": [
        "Leasehold",
        "Multiple-use public forest",
        "Nature conservation reserve",
        "Other Crown land",
        "Private",
        "Unresolved tenure"
      ],
      "range": [
        "#7b867d",
        "#7b867d",
        "#7b867d",
        "#7b867d",
        "#7b867d",
        "#7b867d"
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "name": "alluvialFlows",
      "from": {
        "data": "flowPaths"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "fill": {
            "scale": "statusColor",
            "field": "Status"
          },
          "fillOpacity": {
            "value": 0.75
          },
          "stroke": {
            "value": "#f6f3ec"
          },
          "strokeWidth": {
            "value": 0.7
          },
          "tooltip": {
            "signal": "datum.Tenure + ' → ' + datum.Status + ': ' + format(datum.Forest_area_kha, ',.0f') + ' thousand hectares'"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "tenureNodes",
      "from": {
        "data": "leftNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "lx"
          },
          "x2": {
            "signal": "lx + nw"
          },
          "y": {
            "scale": "yscale",
            "field": "y1"
          },
          "y2": {
            "scale": "yscale",
            "field": "y0"
          },
          "fill": {
            "scale": "tenureColor",
            "field": "Tenure"
          },
          "stroke": {
            "value": "#f6f3ec"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "datum.Tenure + ': ' + format(datum.area, ',.0f') + ' thousand hectares'"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "statusNodes",
      "from": {
        "data": "rightNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "rx"
          },
          "x2": {
            "signal": "rx + nw"
          },
          "y": {
            "scale": "yscale",
            "field": "y1"
          },
          "y2": {
            "scale": "yscale",
            "field": "y0"
          },
          "fill": {
            "scale": "statusColor",
            "field": "Status"
          },
          "stroke": {
            "value": "#f6f3ec"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "datum.Status + ': ' + format(datum.area, ',.0f') + ' thousand hectares'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "tenureLabels",
      "from": {
        "data": "leftNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "lx - 10"
          },
          "y": {
            "signal": "scale('yscale', (datum.y0 + datum.y1) / 2)"
          },
          "text": {
            "signal": "datum.Tenure + '  ' + format(datum.area/131502, '.0%')"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', Arial, sans-serif"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#24392d"
          },
          "opacity": {
            "signal": "datum.area > 1800 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "statusLabels",
      "from": {
        "data": "rightNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "rx + nw + 12"
          },
          "y": {
            "signal": "scale('yscale', (datum.y0 + datum.y1) / 2)"
          },
          "text": {
            "signal": "[datum.Status == 'Within the National Reserve System' ? 'In the National' : 'Outside the', 'Reserve System', format(datum.area/131502, '.0%')]"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', Arial, sans-serif"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#24392d"
          },
          "lineHeight": {
            "value": 19
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#24392d"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0] > 0 ? containerSize()[0] : 850",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] > 0 ? containerSize()[0] : 850"
        }
      ]
    },
    {
      "name": "lx",
      "update": "175"
    },
    {
      "name": "rx",
      "update": "max(lx + 200, width - 190)"
    },
    {
      "name": "nw",
      "value": 14
    }
  ]
}
