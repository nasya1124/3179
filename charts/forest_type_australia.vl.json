{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "../data/forest_type_australia.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Area_kha",
      "type": "quantitative",
      "title": "Area (thousand hectares)"
    },
    "y": {
      "field": "Forest_type",
      "type": "nominal",
      "sort": "-x",
      "title": null
    }
  }
}