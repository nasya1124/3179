{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where three native trees have been recorded",
    "subtitle": "Herbarium records per 1° grid cell",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 19,
    "fontWeight": 700,
    "color": "#1f3326",
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 14,
    "subtitleColor": "#5b6a5f",
    "offset": 10
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "maps/australian-states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e4e8dc",
        "stroke": "#f4f0e7",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "values": [
          {
            "Name": "Western Australia",
            "lon": 122.3,
            "lat": -25.5
          },
          {
            "Name": "Northern Territory",
            "lon": 133.4,
            "lat": -19.5
          },
          {
            "Name": "South Australia",
            "lon": 135.2,
            "lat": -30.0
          },
          {
            "Name": "Queensland",
            "lon": 144.5,
            "lat": -22.5
          },
          {
            "Name": "New South Wales",
            "lon": 146.3,
            "lat": -32.3
          },
          {
            "Name": "Victoria",
            "lon": 142.0,
            "lat": -35.9
          },
          {
            "Name": "Tasmania",
            "lon": 146.6,
            "lat": -44.4
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 13,
        "fontWeight": "normal",
        "lineBreak": "\n",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "Name",
          "type": "nominal"
        },
        "color": {
          "value": "#7d8a80"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.13,
            "lat": -35.45,
            "lon2": 154.8,
            "lat2": -37.3
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#7d8a80",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Name": "Australian Capital\nTerritory",
            "lon": 158.6,
            "lat": -37.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 13,
        "fontWeight": "normal",
        "lineBreak": "\n",
        "align": "right",
        "baseline": "top"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "Name",
          "type": "nominal"
        },
        "color": {
          "value": "#7d8a80"
        }
      }
    },
    {
      "data": {
        "url": "data/tree_species_by_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Longitude": "number",
            "Latitude": "number",
            "Record_count": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "stroke": "#f4f0e7",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Record_count",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              110
            ],
            "range": [
              25,
              700
            ],
            "zero": false
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              20,
              40,
              60,
              80,
              100
            ],
            "title": "Herbarium records per cell",
            "titleLimit": 300
          }
        },
        "color": {
          "field": "Species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Eucalyptus regnans",
              "Araucaria bidwillii",
              "Adansonia gregorii"
            ],
            "range": [
              "#7b5ea7",
              "#c4578f",
              "#3b78b0"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "labelLimit": 160,
            "title": "Species",
            "titleLimit": 300,
            "labelExpr": "datum.label == 'Eucalyptus regnans' ? 'Mountain ash' : datum.label == 'Araucaria bidwillii' ? 'Bunya pine' : 'Boab'"
          }
        },
        "tooltip": [
          {
            "field": "Species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "Record_count",
            "type": "quantitative",
            "title": "Herbarium records in cell",
            "format": ",.0f"
          },
          {
            "field": "Longitude",
            "type": "quantitative",
            "title": "Longitude"
          },
          {
            "field": "Latitude",
            "type": "quantitative",
            "title": "Latitude"
          }
        ],
        "opacity": {
          "condition": {
            "param": "species_pick",
            "value": 0.85
          },
          "value": 0.08
        }
      },
      "params": [
        {
          "name": "species_pick",
          "select": {
            "type": "point",
            "fields": [
              "Species"
            ]
          },
          "bind": "legend"
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "labelColor": "#3d4d42",
      "titleColor": "#1f3326",
      "layout": {
        "bottom": {
          "direction": "vertical",
          "anchor": "start",
          "margin": 8
        }
      },
      "labelFontSize": 14,
      "titleFontSize": 14
    },
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#3d4d42"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": null
}