  "description": "Commercial plantation area by type, 1973-74 to 2021-22, with an overview strip to zoom the detail view (ABARES Indicator 1.1a.iv, Figure 1.1a.iv-4).",
  "title": {
    "text": "Commercial plantation area over time",
    "subtitle": "Thousand hectares · drag across the lower strip to zoom",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 19,
    "fontWeight": 700,
    "color": "#1f3326",
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 14,
    "subtitleColor": "#44524a",
    "offset": 10
  },
  "data": {
    "url": "data/plantation_area_by_type_1974_2022.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Area_kha": "number"
      }
    }
  },
  "background": null,
