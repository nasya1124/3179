{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Protected share of forest by state",
    "subtitle": "Percent of native forest area · 2020–21",
    "anchor": "start",
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "fontSize": 19,
    "fontWeight": 700,
    "color": "#1f3326",
    "subtitleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "subtitleFontSize": 14,
    "subtitleColor": "#5b6a5f",
    "offset": 10
  },
  "data": {
    "url": "data/forest_protection_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "National_Reserve_System_pct": "number",
        "Combined_protection_pct": "number"
      }
    }
  },
  "width": "container",
  "height": 360,
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#b8b9ad",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "National_Reserve_System_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "grid": true,
            "gridColor": "#e9e5d9",
            "labelColor": "#56655a",
            "titleColor": "#3d4d42",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 14,
            "titleFontSize": 13,
            "labelExpr": "datum.value + '%'",
            "titleFontWeight": 600,
            "titlePadding": 10
          },
          "title": "Share of the state's native forest protected"
        },
        "x2": {
          "field": "Combined_protection_pct"
        },
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Combined_protection_pct",
            "order": "descending"
          },
          "axis": {
            "labelColor": "#24392d",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 14,
            "ticks": false,
            "domain": false,
            "labelLimit": 220,
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#3d4d42",
            "titlePadding": 10
          },
          "title": "State or territory"
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "National_Reserve_System_pct",
            "type": "quantitative",
            "title": "National Reserve System (%)",
            "format": ".0f"
          },
          {
            "field": "Combined_protection_pct",
            "type": "quantitative",
            "title": "All reported measures (%)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "National_Reserve_System_pct",
            "Combined_protection_pct"
          ],
          "as": [
            "Measure_field",
            "Share_pct"
          ]
        },
        {
          "calculate": "datum.Measure_field === 'National_Reserve_System_pct' ? 'National Reserve System' : 'All reported biodiversity protection measures'",
          "as": "Measure"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "stroke": "#fffefa",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "grid": true,
            "gridColor": "#e9e5d9",
            "labelColor": "#56655a",
            "titleColor": "#3d4d42",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 14,
            "titleFontSize": 13,
            "labelExpr": "datum.value + '%'",
            "titleFontWeight": 600,
            "titlePadding": 10
          },
          "title": "Share of the state's native forest protected"
        },
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Combined_protection_pct",
            "order": "descending"
          },
          "axis": {
            "labelColor": "#24392d",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 14,
            "ticks": false,
            "domain": false,
            "labelLimit": 220,
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#3d4d42",
            "titlePadding": 10
          },
          "title": "State or territory"
        },
        "color": {
          "field": "Measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "National Reserve System",
              "All reported biodiversity protection measures"
            ],
            "range": [
              "#1f6f78",
              "#8cc5c3"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 14,
            "labelColor": "#56655a",
            "labelLimit": 320,
            "symbolSize": 120,
            "symbolStrokeColor": "#fffefa",
            "symbolStrokeWidth": 1,
            "labelExpr": "datum.label == 'National Reserve System' ? 'National Reserve System' : 'All protection measures'"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "Measure",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "Share_pct",
            "type": "quantitative",
            "title": "Share of native forest area",
            "format": ".0f",
            "formatType": "number"
          }
        ],
        "opacity": {
          "condition": {
            "param": "measure_pick",
            "value": 1
          },
          "value": 0.15
        }
      },
      "params": [
        {
          "name": "measure_pick",
          "select": {
            "type": "point",
            "fields": [
              "Measure"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.State === 'Victoria'"
        },
        {
          "calculate": "(datum.National_Reserve_System_pct + datum.Combined_protection_pct) / 2",
          "as": "mid"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
        "fontSize": 13,
        "color": "#1f3326",
        "align": "center",
        "baseline": "middle",
        "dy": -14,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative",
          "title": "Share of the state's native forest protected",
          "axis": {
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#3d4d42",
            "titlePadding": 10
          }
        },
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Combined_protection_pct",
            "order": "descending"
          },
          "axis": {
            "labelColor": "#24392d",
            "labelFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "labelFontSize": 14,
            "ticks": false,
            "domain": false,
            "labelLimit": 220,
            "titleFont": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#3d4d42",
            "titlePadding": 10
          },
          "title": "State or territory"
        },
        "text": {
          "value": "43-point gap"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
      "color": "#24392d"
    },
    "font": "'Source Sans 3', 'Segoe UI', Arial, sans-serif",
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#3d4d42",
      "titleColor": "#1f3326"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#3d4d42"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": null
}